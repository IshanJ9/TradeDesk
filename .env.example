# Copy to .env. Never commit .env. Only the broker adapter reads broker keys.

# mock | zerotwoone
BROKER=mock
# Enables /api/chaos/* and /api/locks/* demo toggles
DEMO_MODE=true

# LLM provider. Blank or 'rules' = built-in keyword parser; 'bedrock' = AWS Bedrock.
LLM_PROVIDER=rules
LLM_API_KEY=

# Bedrock API key (backend only). Add your key to the private .env file.
# Set LLM_PROVIDER=bedrock to use Bedrock in the TradeDesk chat.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=openai.gpt-oss-120b-1:0

# classic = current copilot loop; langgraph = graph orchestrator (app/agent/)
ORCHESTRATOR=classic

# Voice input: Groq speech-to-text (backend only)
GROQ_API_KEY=
VOICE_MODEL=whisper-large-v3-turbo
# groq | local. local = faster-whisper on this machine (pip install -r requirements-voice-local.txt, then
# python scripts/download_voice_model.py). The app never downloads a model by itself.
VOICE_PROVIDER=groq
# When local fails: groq (uploads the audio, and the chat says so) | none (audio stays local)
VOICE_FALLBACK=groq
# LOCAL_VOICE_DIR=.cache/whisper-small

# 021 sandbox. USERNAME is your UCC (e.g. HACK1234), not your email. Logging in revokes any other token
# for the account, so run one copy of the app per account.
ZEROTWOONE_USERNAME=
ZEROTWOONE_PASSWORD=
# ZEROTWOONE_BASE_URL=https://devapi.021.trade/api/developer-api/v1
# ZEROTWOONE_CACHE_DIR=.cache

DATABASE_URL=sqlite:///./tradedesk.db

# Safety defaults (override only on purpose)
APPROVAL_TTL_SECONDS=60
DRIFT_LIMIT_PCT=1.0

# Order safety (defaults are 021's published rejection limits; tighten for demos)
MARKET_PROTECTION_PCT=1.0
MAX_ORDER_QUANTITY=100000
MAX_ORDER_VALUE_RUPEES=10000000

# Opening futures and selling options you don't hold (writing) can lose more than you put in. Refused unless true.
# Closing a futures or option position you already hold is always allowed.
ALLOW_UNLIMITED_RISK_FO=false

# Co-Captain: a second person's approval, only past limits you set yourself. Off unless true. Past a limit with no
# Co-Captain, the order is paused. Needs an explicit account owner (the trader's id).
COCAPTAIN_ENABLED=false
COCAPTAIN_ACCOUNT_OWNER_ID=
# Demo only (also needs DEMO_MODE=true): a configured list of people and an /app?as=<id> chooser, until real login exists.
COCAPTAIN_DEV_ACTORS=false
# e.g. [{"id":"a","display_name":"Trader","email":"a@example.com"},{"id":"b","display_name":"Ravi","email":"b@example.com"}]
COCAPTAIN_DEV_USERS=[]
